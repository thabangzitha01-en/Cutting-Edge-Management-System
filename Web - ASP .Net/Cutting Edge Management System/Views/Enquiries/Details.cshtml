@* ============================================================
   PROJECT: Cutting Edge Salon
   STUDENT DETAILS:
   ------------------------------------------------------------
   Name                  | Student Number
   ------------------------------------------------------------
   Goitse Kgwele         | 221050663
   Thabang Zitha         | 223007074
   Yamkela Mazamani      | 224007421
   Nyakallo Pali         | 223060226
   Bennet Linda          | 224004294
   ============================================================ *@

@model CuttingEdge.ManagerPortal.Models.CustomerEnquiry
@{
    ViewData["Title"] = "Customer Message";
    Layout = "_Layout";
    var leaveGroupId = ViewBag.LeaveGroupId as Guid?;
    var isLeaveRequest = Model.Category == "stylist_leave_request";
    var isReplied = Model.Status == "replied";
}

<div class="page-header">
    <p class="breadcrumb">Enquiries → @(isLeaveRequest ? "Stylist Leave Request" : "Customer Message")</p>
    <p class="subtitle">@Model.Category · Received @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="status">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="details-grid">
    <div class="detail-group">
        <label>@(isLeaveRequest ? "Stylist" : "Customer")</label>
        <div class="detail-value">@Model.CustomerName</div>
    </div>

    <div class="detail-group">
        <label>Email</label>
        <div class="detail-value">@Model.CustomerEmail</div>
    </div>

    <div class="detail-group">
        <label>Category</label>
        <div class="detail-value">@Model.Category</div>
    </div>

    <div class="detail-group">
        <label>Status</label>
        <div class="detail-value">
            <span class="badge @(isReplied ? "badge-completed" : "badge-incomplete")">
                @(isReplied ? (isLeaveRequest ? "Resolved" : "Replied") : (isLeaveRequest ? "Awaiting Decision" : "Awaiting reply"))
            </span>
        </div>
    </div>
</div>

<div class="detail-group full-width">
    <label>@(isLeaveRequest ? "Request Details" : "Message")</label>
    <div class="detail-value message">@System.Text.RegularExpressions.Regex.Replace(Model.Message, @"^\s*Stylist ID:\s*\d+\s*\|\s*", "")</div>
</div>

<div class="detail-group full-width action-panel">
    <label>Manager Action</label>

    @if (isReplied)
    {
        <div class="detail-value message">@Model.ManagerReply</div>
        <p class="hint">Decision made on @(Model.RepliedAt.HasValue? Model.RepliedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm") : "Unknown").</p>
    }
    else if (isLeaveRequest)
    {
        @if (leaveGroupId.HasValue && leaveGroupId.Value != Guid.Empty)
        {
            <p class="hint">
                You must write a reply below before you can approve or reject this request.<br />
                <strong>Approving</strong> keeps the dates blocked.<br />
                <strong>Rejecting</strong> removes the blocks and makes the stylist available again.
            </p>

            <form id="leaveReviewForm" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="groupId" value="@leaveGroupId.Value" />
                <input type="hidden" name="enquiryId" value="@Model.EnquiryId" />

                <label for="managerNote" class="field-label">Reply / Reason for Decision</label>
                <textarea id="managerNote" name="managerNote" class="form-control" maxlength="1000" required
                  placeholder="Explain your decision here. This will be sent to the stylist in their Flutter app..."
                  oninput="toggleLeaveButtons()"></textarea>

                <div class="action-buttons">
                    <button type="submit" formaction="@Url.Action("ApproveLeave", "Enquiries")" id="btnApprove" class="btn btn-success" disabled onclick="return confirm('Approve this leave? The dates will stay blocked.');">
                        ✔ Approve Leave
                    </button>
                    <button type="submit" formaction="@Url.Action("RejectLeave", "Enquiries")" id="btnReject" class="btn btn-danger" disabled onclick="return confirm('Reject this leave? The dates will become bookable again.');">
                        ✖ Reject Leave
                    </button>
                </div>
            </form>
        }
        else
        {
            <p class="hint error">This leave request is either already processed or missing its grouping ID in the database.</p>
        }
    }
    else
    {
        <p class="hint">Your reply will be saved in Supabase and sent to this customer's Notifications screen.</p>
        <form asp-action="Reply" asp-route-id="@Model.EnquiryId" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <label for="replyMessage" class="field-label">Message to customer</label>
            <textarea id="replyMessage" name="replyMessage" class="form-control" maxlength="5000" required placeholder="Write your reply here..."></textarea>
            <div class="action-buttons">
                <button type="submit" class="btn btn-primary" onclick="return confirm('Send this reply to the customer?');">Send Reply &amp; Notify Customer</button>
            </div>
        </form>
    }
</div>

<div class="action-buttons">
    <a asp-action="Index" class="btn btn-secondary">Back to Enquiries</a>
</div>

<script>
    function toggleLeaveButtons() {
        const note = document.getElementById('managerNote').value.trim();
        const btnApprove = document.getElementById('btnApprove');
        const btnReject = document.getElementById('btnReject');

        const isDisabled = note.length === 0;

        if (btnApprove) btnApprove.disabled = isDisabled;
        if (btnReject) btnReject.disabled = isDisabled;
    }
</script>

<style>

    /* ===== Page header (same as Bookings / Reviews) ===== */
    .page-header {
        margin-bottom: 25px;
    }

    .breadcrumb {
        color: #888;
        font-size: 13px;
        margin: 0 0 8px 0;
    }

    .page-header .subtitle {
        color: #888;
        font-size: 14px;
        margin: 5px 0 0 0;
    }

    /* ===== Buttons ===== */
    .btn {
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        text-decoration: none;
        display: inline-block;
        font-family: inherit;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #d4af37;
        color: #0d0d0d;
    }

        .btn-primary:hover {
            background-color: #f0d060;
            color: #0d0d0d;
            text-decoration: none;
        }

    .btn-secondary {
        background-color: #333;
        color: #fff;
    }

        .btn-secondary:hover {
            background-color: #444;
            color: #fff;
            text-decoration: none;
        }

    .btn-sm {
        padding: 7px 16px;
        font-size: 13px;
    }

    .btn-outline {
        background-color: transparent;
        border: 1px solid #d4af37;
        color: #d4af37;
    }

        .btn-outline:hover {
            background-color: #d4af37;
            color: #0d0d0d;
            text-decoration: none;
        }

    /* ===== Status badges (same as Bookings) ===== */
    .badge {
        display: inline-block;
        padding: 6px 18px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        min-width: 100px;
        text-align: center;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    .badge-completed {
        background-color: rgba(40, 167, 69, 0.08);
        color: #28a745;
        border: 2px solid #28a745;
    }

    .badge-incomplete {
        background-color: rgba(212, 175, 55, 0.08);
        color: #d4af37;
        border: 2px solid #d4af37;
    }

    /* ===== Alerts ===== */
    .alert {
        padding: 14px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-success {
        background-color: rgba(40, 167, 69, 0.15);
        border: 1px solid #28a745;
        color: #28a745;
    }

    .alert-danger {
        background-color: rgba(220, 53, 69, 0.15);
        border: 1px solid #dc3545;
        color: #ff6b6b;
    }

    .btn {
        padding: 12px 24px;
        font-weight: 700;
    }

    .btn-danger {
        background-color: #9f3333;
        color: #fff;
    }

        .btn-danger:hover:not(:disabled) {
            background-color: #b73a3a;
        }

    .btn-success {
        background-color: #28a745;
        color: #fff;
    }

        .btn-success:hover:not(:disabled) {
            background-color: #2fbd50;
        }

    .btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    /* ===== Detail cards (same as Booking Details) ===== */
    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .detail-group {
        background-color: #1a1a1a;
        border: 1px solid #333;
        border-radius: 10px;
        padding: 16px 20px;
    }

        .detail-group.full-width {
            grid-column: 1 / -1;
            margin-bottom: 25px;
        }

        .detail-group label {
            display: block;
            color: #d4af37;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .detail-value {
        color: #fff;
        font-size: 15px;
        padding: 4px 0;
        overflow-wrap: anywhere;
    }

        .detail-value.message {
            color: #ddd;
            font-size: 14px;
            line-height: 1.65;
            white-space: pre-wrap;
            background-color: #0d0d0d;
            border-left: 3px solid #d4af37;
            border-radius: 6px;
            padding: 14px 16px;
        }

    /* ===== Manager action ===== */
    .action-panel .field-label {
        margin-top: 14px;
    }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 8px;
        color: #fff;
        font-size: 14px;
        font-family: inherit;
        outline: none;
        box-sizing: border-box;
        transition: all 0.3s ease;
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .form-control:focus {
        border-color: #d4af37;
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
    }

    .hint {
        color: #888;
        font-size: 13px;
        line-height: 1.6;
        margin: 8px 0 4px 0;
    }

        .hint strong {
            color: #d4af37;
        }

        .hint.error {
            color: #ff6b6b;
        }

    .action-buttons {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    @@media (max-width: 700px) {
        .details-grid {
            grid-template-columns: 1fr;
        }

        .action-buttons .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
