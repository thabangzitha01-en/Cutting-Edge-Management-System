<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cutting Edge Manager Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @{
        // Real user info from the auth cookie claims
        var userEmail = User?.Identity?.Name
        ?? Context.Session.GetString("UserEmail")
        ?? "manager@cuttingedge.co.za";

        var fullName = User?.FindFirst("FullName")?.Value
        ?? Context.Session.GetString("FullName")
        ?? "Manager";

        var role = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
        ?? Context.Session.GetString("UserRole")
        ?? "Manager";

        var photoUrl = User?.FindFirst("PhotoUrl")?.Value
        ?? Context.Session.GetString("PhotoUrl");

        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var isAuthPage = currentController == "Account" || currentController == "Home";
    }

    @if (isAuthPage)
    {
        <!-- Auth pages render without sidebar -->
        @RenderBody()
    }
    else
    {
        <div class="app-layout">

            <!-- ========== SIDEBAR ========== -->
            <aside class="sidebar" id="sidebar">
                <div class="sidebar-header">
                    <img src="~/images/cutting-edge-logo.jpeg" alt="Cutting Edge" class="sidebar-logo" />
                    <div class="sidebar-brand">
                        <h1>CUTTING EDGE</h1>
                        <p>SALON MANAGEMENT SYSTEM</p>
                        <span class="tagline">Our Vision. Your Style.</span>
                    </div>
                </div>

                <nav class="sidebar-nav">
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="nav-item @(currentController == "Dashboard" ? "active" : "")">
                        <span class="nav-label">Dashboard</span>
                    </a>

                    <a asp-controller="Bookings" asp-action="Index"
                       class="nav-item @(currentController == "Bookings" ? "active" : "")">
                        <span class="nav-label">Bookings</span>
                    </a>

                    <a asp-controller="Stylists" asp-action="Index"
                       class="nav-item @(currentController == "Stylists" ? "active" : "")">
                        <span class="nav-label">Stylists</span>
                    </a>

                    <a asp-controller="Services" asp-action="Index"
                       class="nav-item @(currentController == "Services" || currentController == "Promotions" ? "active" : "")">
                        <span class="nav-label">Services & Promotions</span>
                    </a>

                    <a asp-controller="Schedules" asp-action="Index"
                       class="nav-item @(currentController == "Schedules" ? "active" : "")">
                        <span class="nav-label">Schedule</span>
                    </a>

                    <a asp-controller="Reports" asp-action="Index"
                       class="nav-item @(currentController == "Reports" ? "active" : "")">
                        <span class="nav-label">Reports</span>
                    </a>

                    <a asp-controller="Gallery" asp-action="Index"
                       class="nav-item @(currentController == "Gallery" ? "active" : "")">
                        <span class="nav-label">Gallery</span>
                    </a>

                    <a asp-controller="Reviews" asp-action="Index"
                       class="nav-item @(currentController == "Reviews" ? "active" : "")">
                        <span class="nav-label">Reviews</span>
                    </a>

                    <a asp-controller="Enquiries" asp-action="Index"
                       class="nav-item @(currentController == "Enquiries" ? "active" : "")">
                        <span class="nav-label">Enquiries</span>
                    </a>

                    <a asp-controller="Profile" asp-action="Index"
                       class="nav-item @(currentController == "Profile" ? "active" : "")">
                        <span class="nav-label">My Profile</span>
                    </a>

                    <div class="nav-divider"></div>

                    <!-- Logout Button (Triggers the popup) -->
                    <a href="javascript:void(0);" class="nav-item nav-logout" onclick="window.showLogoutModal()" style="width: 100%; display: flex; align-items: center; text-decoration: none; cursor: pointer;">
                        <span class="nav-icon">↩</span>
                        <span class="nav-label">Logout</span>
                    </a>
                </nav>
            </aside>

            <!-- ========== MAIN AREA ========== -->
            <div class="main-area">

                <!-- Top Bar -->
                <header class="top-bar">
                    <button class="menu-toggle" onclick="toggleSidebar()" aria-label="Toggle menu">☰</button>

                    <h2 class="page-title">@ViewData["Title"]</h2>

                    <div class="top-bar-user">
                        <div class="user-info">
                            <div class="user-name">@fullName</div>
                            <div class="user-role">@role</div>
                        </div>
                        <div class="user-avatar">
                            @if (!string.IsNullOrEmpty(photoUrl))
                            {
                                <img src="@photoUrl" alt="@fullName" class="user-avatar-img" />
                            }
                            else
                            {
                                <!-- Generic profile icon when no photo -->
                                <svg class="user-avatar-icon"
                                     xmlns="http://www.w3.org/2000/svg"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                            }
                        </div>
                    </div>
                </header>

                <!-- Page content -->
                <main class="content-area">
                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="app-footer">
                    <p>© @DateTime.Now.Year Cutting Edge Salon — Our Vision. Your Style.</p>
                </footer>
            </div>
        </div>
    }
 <!-- End of Auth Page Check -->
    <!-- ========== LOGOUT CONFIRMATION MODAL ========== -->
    <!-- Placed outside the if/else block to ensure it always loads in the DOM -->
    <div id="logoutModal" style="display:none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-color: rgba(0,0,0,.75); align-items: center; justify-content: center; z-index: 99999;">
        <div style="background-color: #1a1a1a; border: 1px solid #333; border-radius: 12px; padding: 30px; max-width: 400px; width: 90%; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.5);">
            <h3 style="color: #d4af37; font-size: 20px; font-weight: 700; margin-top: 0; margin-bottom: 10px;">Ready to leave?</h3>
            <p style="color: #aaa; font-size: 14px; margin-bottom: 25px;">Are you sure you want to log out of your account?</p>

            <div style="display: flex; gap: 10px; justify-content: center;">
                <!-- Cancel Button -->
                <button type="button" onclick="window.hideLogoutModal()" style="padding: 10px 20px; border-radius: 8px; background-color: #333; color: #fff; border: none; cursor: pointer; font-weight: 700; font-size: 13px;">
                    Cancel
                </button>

                <!-- Actual Logout Form -->
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" style="padding: 10px 20px; border-radius: 8px; background-color: transparent; border: 1px solid #dc3545; color: #dc3545; cursor: pointer; font-weight: 700; font-size: 13px;">
                        Yes, Log Out
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ========== JAVASCRIPT ========== -->
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('sidebar-open');
            document.body.classList.toggle('sidebar-active');
        }

        // Define functions globally to prevent scope issues
        window.showLogoutModal = function() {
            var modal = document.getElementById('logoutModal');
            if (modal) {
                modal.style.display = 'flex';
            }
        };

        window.hideLogoutModal = function() {
            var modal = document.getElementById('logoutModal');
            if (modal) {
                modal.style.display = 'none';
            }
        };
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
